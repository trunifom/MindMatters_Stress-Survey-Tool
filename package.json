{
  "name": "mindmatters-stress-survey-tool",
  "version": "0.0.1",
  "private": true,
  "description": "Offline-Konfigurator fuer psychometrische Fragebogen (eine HTML-Datei).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.core.json",
    "build": "node tools/build.mjs",
    "test:e2e": "vitest run -c vitest.e2e.config.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.65.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
