        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "maxDecimalPlaces": {
          "type": "integer",
          "minimum": 0
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        },
        "validationMessage": {
          "$ref": "#/$defs/LocalizedText"
        }
      }
    },
    "RespShortText": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "shortText"
        },
        "minLength": {
          "type": "integer",
          "minimum": 0
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0
        },
        "validationMessage": {
          "$ref": "#/$defs/LocalizedText"
        },
        "format": {
          "description": "Structured text format; adapters map to native validation or report manual.",
          "enum": [
            "email",
            "url",
            "phone"
          ]
        }
      }
    },
    "RespLongText": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "longText"
        },
        "minLength": {
          "type": "integer",
          "minimum": 0
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0
        },
        "validationMessage": {
          "$ref": "#/$defs/LocalizedText"
        }
      }
    },
    "RespDate": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "date"
        },
        "minimum": {
          "$ref": "#/$defs/Date"
        },
        "maximum": {
          "$ref": "#/$defs/Date"
        },
        "validationMessage": {
          "$ref": "#/$defs/LocalizedText"
        }
      }
    },
    "Presentation": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "widget"
          ]
        },
        {
          "required": [
            "orientation"
          ]
        },
        {
          "required": [
            "optionOrder"
          ]
        }
      ],
      "properties": {
        "widget": {
          "enum": [
            "radio",
            "dropdown",
            "checkbox",
            "number",
            "text",
            "textarea",
            "date",
            "slider"
          ]
        },
        "orientation": {
          "enum": [
            "vertical",
            "horizontal"
          ]
        },
        "optionOrder": {
          "description": "random requires feature randomization; never silently applied to Likert scales.",
          "enum": [
            "fixed",
            "random"
          ]
        }
      }
    },
    "Condition": {
      "type": "object",
      "required": [
        "itemRef",
        "operator",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "itemRef": {
          "$ref": "#/$defs/Id"
        },
        "operator": {
          "enum": [
            "equals",
            "notEquals",
            "contains",
            "notContains",
            "greaterThan",
            "greaterThanOrEqual",
            "lessThan",
            "lessThanOrEqual"
          ]
        },
        "value": {
          "type": "string"
        }
      }
    },
    "Item": {
      "type": "object",
      "required": [
        "id",
        "version",
        "text",
        "response",
        "inclusionRequired",
        "answerRequired",
        "defaultSelected",
        "variableName",
        "constructRefs"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "version": {
          "$ref": "#/$defs/SemVer"
        },
        "text": {
          "$ref": "#/$defs/LocalizedText"
        },
        "response": {
          "$ref": "#/$defs/Response"
        },
        "inclusionRequired": {
          "type": "boolean"
        },
        "answerRequired": {
          "type": "boolean"
        },
        "defaultSelected": {
          "type": "boolean"
        },
        "variableName": {
          "$ref": "#/$defs/Id"
        },
        "constructRefs": {
          "$ref": "#/$defs/IdList"
        },
        "instrumentRef": {
          "$ref": "#/$defs/Id"
        },
        "originalItemNumber": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "instruction": {
          "$ref": "#/$defs/LocalizedText"
        },
        "respondentHelp": {
          "$ref": "#/$defs/LocalizedText"
        },
        "organizerHelp": {
          "$ref": "#/$defs/LocalizedText"
        },
        "referencePeriod": {
          "$ref": "#/$defs/ReferencePeriod"
        },
        "sourceLinks": {
          "$ref": "#/$defs/SourceLinks"
        },
        "rightsRef": {
          "$ref": "#/$defs/Id"
        },
        "presentation": {
          "$ref": "#/$defs/Presentation"
        },
        "visibleWhen": {
          "$ref": "#/$defs/ConditionOrGroup"
        },
        "documentation": {
          "$ref": "#/$defs/Documentation"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NonEmptyString"
          }
        },
        "extensions": {
          "$ref": "#/$defs/Extensions"
        },
        "exportLabel": {
          "description": "Short variable label for codebooks/SPSS/R; distinct from display text.",
          "$ref": "#/$defs/LocalizedText"
        },
        "displayNumber": {
          "description": "Number shown to respondents; distinct from originalItemNumber.",
          "$ref": "#/$defs/NonEmptyString"
        },
        "requiredMessage": {
          "description": "Message shown when a required answer is missing.",
          "$ref": "#/$defs/LocalizedText"
        },
        "keyDirection": {
          "enum": [
            "positive",
            "negative",
            "unspecified"
          ],
          "description": "Scoring direction of the item relative to its construct."
        },
        "origin": {
          "enum": [
            "original",
            "adapted",
            "own"
          ],
          "description": "own = newly authored; never output as a validated instrument item."
        },
        "sensitivity": {
          "type": "object",
          "required": [
            "level"
          ],
          "additionalProperties": false,
          "properties": {
            "level": {
              "enum": [
                "sensitive",
                "highlySensitive"
              ]
            },
            "warningText": {
              "$ref": "#/$defs/LocalizedText"
            },
            "helpResourcesText": {
              "$ref": "#/$defs/LocalizedText"
            },
            "excludeFromExportByDefault": {
              "type": "boolean"
            }
          }
        },
        "exportHints": {
          "description": "Per-platform overrides. Keys are platform ids (limesurvey, redcap, qualtrics, surveymonkey, googleForms, unipark, or a custom lowerCamelCase id).",
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][A-Za-z0-9]{0,31}$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "variableName": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]{0,99}$"
              },
              "label": {
                "$ref": "#/$defs/LocalizedText"
              },
              "notes": {
                "$ref": "#/$defs/LocalizedText"
              }
            }
          }
        }
      },
      "if": {
        "properties": {
          "inclusionRequired": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "defaultSelected": {
            "const": true
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "response": {
                "properties": {
                  "kind": {
                    "const": "note"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            },
            "required": [
              "response"
            ]
          },
          "then": {
            "properties": {
              "answerRequired": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "Module": {
      "type": "object",
      "required": [
        "id",
        "title",
        "description",
        "itemRefs",
        "selectionMode",
        "inclusionRequired",
        "defaultSelected"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "title": {
          "$ref": "#/$defs/LocalizedText"
        },
        "description": {
          "$ref": "#/$defs/LocalizedText"
        },
        "itemRefs": {
          "$ref": "#/$defs/NonEmptyIdList"
        },
        "selectionMode": {
          "enum": [
            "independent",
            "allOrNothing"
          ]
        },
        "inclusionRequired": {
          "type": "boolean"
        },
        "defaultSelected": {
          "type": "boolean"
        },
        "scaleRefs": {
          "$ref": "#/$defs/IdList"
        },
        "documentation": {
          "$ref": "#/$defs/Documentation"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "selectionMode": {
                "const": "independent"
              }
            }
          },
          "then": {
            "properties": {
              "inclusionRequired": {
                "const": false
              },
              "defaultSelected": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "inclusionRequired": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "defaultSelected": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "Section": {
      "type": "object",
      "required": [
        "id",
        "title",
        "itemRefs"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "title": {
          "$ref": "#/$defs/LocalizedText"
        },
        "itemRefs": {
          "$ref": "#/$defs/NonEmptyIdList"
        },
        "instruction": {
          "$ref": "#/$defs/LocalizedText"
        },
        "layout": {
          "enum": [
            "list",
            "matrix",
            "table"
          ],
          "description": "matrix/table = one shared option set across items (batteries). Adapters map to LimeSurvey array, REDCap matrix group, etc."
        },
        "pageBreakBefore": {
          "type": "boolean"
        }
      }
    },
    "Questionnaire": {
      "type": "object",
      "required": [
        "id",
        "title",
        "sections"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "title": {
          "$ref": "#/$defs/LocalizedText"
        },
        "introduction": {
          "$ref": "#/$defs/LocalizedText"
        },
        "closingText": {
          "$ref": "#/$defs/LocalizedText"
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Section"
          }
        },
        "consent": {
          "type": "object",
          "required": [
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "title": {
              "$ref": "#/$defs/LocalizedText"
            },
            "text": {
              "$ref": "#/$defs/LocalizedText"
            },
            "parentalConsentText": {
              "$ref": "#/$defs/LocalizedText"
            },
            "requiresParentalConsent": {
              "type": "boolean"
            }
          }
        },
        "privacyNotice": {
          "$ref": "#/$defs/LocalizedText"
        },
        "helpResources": {
          "$ref": "#/$defs/LocalizedText"
        },
        "delivery": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "pageMode": {
              "enum": [
                "onePage",
                "perSection",
                "perItem"
              ]
            },
            "showProgress": {
              "type": "boolean"
            },
            "allowBackNavigation": {
              "type": "boolean"
            },
            "anonymity": {
              "enum": [
                "anonymous",
                "pseudonymous",
                "identified"
              ]
            },
            "pseudonymizationNote": {
              "$ref": "#/$defs/LocalizedText"
            }
          }
        },
        "hiddenFields": {
          "description": "Grouping/context variables (school, class, wave). Not questions.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "variableName",
              "source"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/Id"
              },
              "variableName": {
                "$ref": "#/$defs/Id"
              },
              "source": {
                "enum": [
                  "urlParameter",
                  "embeddedData",
                  "constant"
                ]
              },
              "constantValue": {
                "type": "string"
              },
              "label": {
                "$ref": "#/$defs/LocalizedText"
              },
              "description": {
                "$ref": "#/$defs/LocalizedText"
              }
            },
            "if": {
              "properties": {
                "source": {
                  "const": "constant"
                }
              }
            },
            "then": {
              "required": [
                "constantValue"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "constantValue"
                ]
              }
            }
          }
        }
      }
    },
    "ScoreMapping": {
      "type": "object",
      "required": [
        "itemRef",
        "rawToScore",
        "missingCodes"
      ],
      "additionalProperties": false,
      "properties": {
        "itemRef": {
          "$ref": "#/$defs/Id"
        },
        "rawToScore": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "code",
              "score"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "score": {
                "type": "number"
              }
            }
          }
        },
        "missingCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ScoreDefinition": {
      "type": "object",
      "required": [
        "id",
        "title",
        "itemRefs",
        "method",
        "itemMappings",
        "minimumAnswered",
        "interpretationDirection"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "title": {
          "$ref": "#/$defs/LocalizedText"
        },
        "itemRefs": {
          "$ref": "#/$defs/NonEmptyIdList"
        },
        "method": {
          "enum": [
            "sum",
            "mean"
          ]
        },
        "itemMappings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScoreMapping"
          }
        },
        "minimumAnswered": {
          "type": "integer",
          "minimum": 1
        },
        "interpretationDirection": {
          "enum": [
            "higherMore",
            "higherLess",
            "notSpecified"
          ]
        },
        "sourceLinks": {
          "$ref": "#/$defs/SourceLinks"
        },
        "documentation": {
          "$ref": "#/$defs/Documentation"
        },
        "scaleRef": {
          "$ref": "#/$defs/Id"
        }
      }
    },
    "RespSlider": {
      "description": "Continuous or stepped scale. Feature: sliderResponse.",
      "type": "object",
      "required": [
        "kind",
        "minimum",
        "maximum"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "slider"
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "step": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "labels": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": {
              "$ref": "#/$defs/LocalizedText"
            },
            "mid": {
              "$ref": "#/$defs/LocalizedText"
            },
            "max": {
              "$ref": "#/$defs/LocalizedText"
            }
          }
        },
        "showValue": {
          "type": "boolean"
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        },
        "validationMessage": {
          "$ref": "#/$defs/LocalizedText"
        }
      }
    },
    "RespRanking": {
      "description": "Respondent orders options. Feature: rankingResponse.",
      "type": "object",
      "required": [
        "kind",
        "optionSetRef"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "ranking"
        },
        "optionSetRef": {
          "$ref": "#/$defs/Id"
        },
        "maxRanks": {
          "type": "integer",
          "minimum": 1
        },
        "validationMessage": {
          "$ref": "#/$defs/LocalizedText"
        }
      }
    },
    "RespNote": {
      "description": "Display-only text block (no answer): title, subtitle, paragraph text or notice. The item text is the content. Feature: noteItems.",
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "note"
        },
        "style": {
          "enum": [
            "text",
            "title",
            "subtitle",
            "notice"
          ],
          "description": "Presentation role. Default: text. Content is plain text: paragraphs separated by a blank line, lines starting with '- ' form a list. No HTML."
        }
      }
    },
    "ConditionGroup": {
      "description": "Compound visibility. Feature: compoundVisibility.",
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "all"
          ]
        },
        {
          "required": [
            "any"
          ]
        }
      ],
      "properties": {
        "all": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/Condition"
          }
        },
        "any": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/Condition"
          }
        }
      }
    },
    "ConditionOrGroup": {
      "oneOf": [
        {
          "$ref": "#/$defs/Condition"
        },
        {
          "$ref": "#/$defs/ConditionGroup"
        }
      ]
    }
  }
}
