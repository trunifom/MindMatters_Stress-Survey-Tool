{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindmatters.example/schema/0.4.0/project.schema.json",
  "title": "Questionnaire project (schemaVersion 0.4.0)",
  "description": "Project file: references an exact catalog and stores the selection only, never item texts. Mandatory-set completion and ID existence are checked by the semantic validator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "documentType",
    "catalogRef",
    "questionnaireRef",
    "selectedItemIds",
    "language"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.4.0"
    },
    "documentType": {
      "const": "questionnaireProject"
    },
    "catalogRef": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      }
    },
    "questionnaireRef": {
      "$ref": "#/$defs/Id"
    },
    "selectedItemIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/Id"
      }
    },
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "targetPlatform": {
      "type": "string",
      "minLength": 1
    },
    "schoolLabel": {
      "type": "string",
      "minLength": 1
    },
    "internalNotes": {
      "type": "string",
      "minLength": 1
    },
    "savedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "customization": {
      "type": "object",
      "additionalProperties": false,
      "description": "Texts the school adapted and text blocks it added. Applied on top of the catalog; the catalog itself is never changed. Texts the catalog marks as locked are ignored.",
      "properties": {
        "textOverrides": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "$ref": "#/$defs/LocalizedText"
            },
            "introduction": {
              "$ref": "#/$defs/LocalizedText"
            },
            "closingText": {
              "$ref": "#/$defs/LocalizedText"
            },
            "privacyNotice": {
              "$ref": "#/$defs/LocalizedText"
            },
            "helpResources": {
              "$ref": "#/$defs/LocalizedText"
            },
            "consentTitle": {
              "$ref": "#/$defs/LocalizedText"
            },
            "consentText": {
              "$ref": "#/$defs/LocalizedText"
            },
            "parentalConsentText": {
              "$ref": "#/$defs/LocalizedText"
            }
          }
        },
        "noteOverrides": {
          "type": "object",
          "description": "Adapted wording of text blocks (items of kind note) of the catalog, by item id. Blocks the catalog locks are ignored.",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/LocalizedText"
          }
        },
        "customBlocks": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "style",
              "text",
              "sectionRef"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^custom_[a-z0-9_]{1,56}$"
              },
              "style": {
                "enum": [
                  "title",
                  "subtitle",
                  "text",
                  "notice"
                ]
              },
              "text": {
                "$ref": "#/$defs/LocalizedText"
              },
              "sectionRef": {
                "$ref": "#/$defs/Id"
              },
              "afterItemRef": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Id"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Item after which the block appears; null or missing means at the start of the section."
              }
            }
          }
        },
        "sectionOrder": {
          "type": "array",
          "uniqueItems": true,
          "description": "Order of the movable sections. Sections that are not movable keep their place.",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "itemOrder": {
          "type": "object",
          "description": "Order of the items inside a section whose items may be reordered, by section id.",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 1000,
            "items": {
              "$ref": "#/$defs/Id"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "Id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "LocalizedText": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/LanguageTag"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "LanguageTag": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    }
  }
}
