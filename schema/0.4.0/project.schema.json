{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindmatters.example/schema/0.4.0/project.schema.json",
  "title": "Questionnaire project (schemaVersion 0.4.0)",
  "description": "Project file: references an exact catalog and stores the selection only, never item texts. Mandatory-set completion and ID existence are checked by the semantic validator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "documentType",
    "catalogRef",
    "questionnaireRef",
    "selectedItemIds",
    "language"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.4.0"
    },
    "documentType": {
      "const": "questionnaireProject"
    },
    "catalogRef": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      }
    },
    "questionnaireRef": {
      "$ref": "#/$defs/Id"
    },
    "selectedItemIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/Id"
      }
    },
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "targetPlatform": {
      "type": "string",
      "minLength": 1
    },
    "schoolLabel": {
      "type": "string",
      "minLength": 1
    },
    "internalNotes": {
      "type": "string",
      "minLength": 1
    },
    "savedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  },
  "$defs": {
    "Id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    }
  }
}